# Local-only SiliconBoutique credential settings.
# Copy to credential.env and keep credential.env untracked.

# BigQuery destination for local benchmark summary persistence.
PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=silicon_boutique
BIGQUERY_TABLE=benchmark_summaries
BIGQUERY_LOCATION=US

# Recommended local authentication is Application Default Credentials:
#   gcloud auth application-default login
#
# Optional service account key path, stored outside git or under ignored credentials/.
# GOOGLE_APPLICATION_CREDENTIALS=credentials/silicon-boutique-bigquery-writer.key.json

# GitHub Actions OIDC settings are used by cloud workflows, not local BigQuery loads.
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/.../locations/global/workloadIdentityPools/.../providers/...
# GCP_SERVICE_ACCOUNT=silicon-boutique-benchmark@your-gcp-project-id.iam.gserviceaccount.com
